# Development placeholders only. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Admin/migration role (owner of schema; used by db:migrate and db:seed only)
DATABASE_ADMIN_URL=postgres://opshub_admin:change-me-admin@localhost:5432/opshub
# Normal application role (no superuser, no BYPASSRLS)
DATABASE_URL=postgres://opshub_app:change-me-app@localhost:5432/opshub

# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Access token lifetime in seconds (short; the refresh token keeps users signed in)
JWT_EXPIRES_IN_SECONDS=600
# Refresh token lifetime in seconds (sliding window, default 7 days)
REFRESH_EXPIRES_IN_SECONDS=604800
